{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "sourceMap": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["*.ts"],
  "exclude": ["dist", "node_modules"]
}
